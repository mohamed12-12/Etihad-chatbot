# ============================================
# Server
# ============================================
PORT=3000
NODE_ENV=production

# ============================================
# Meta / Facebook App (developers.facebook.com)
# ============================================
# Optional fallback token for local/manual testing. In production multi-page mode,
# clients connect through /connect and tokens are stored in data/pages.json.
PAGE_ACCESS_TOKEN=

# Any string you choose. Must match exactly what you enter in the Meta
# Developer Console webhook setup screen ("Verify Token" field).
VERIFY_TOKEN=

# From Meta App > Settings > Basic > App Secret. Used to validate that
# incoming webhook calls really came from Meta (X-Hub-Signature-256).
APP_SECRET=

# From Meta App Dashboard > Settings > Basic.
META_APP_ID=

# Optional. If unset, APP_SECRET is reused for OAuth token exchange.
META_APP_SECRET=

# Facebook Login for Business redirect URI. Add this exact URL in Meta Login settings.
OAUTH_REDIRECT_URI=https://Etihad.cvis.com.eg/connect/callback
META_GRAPH_VERSION=v23.0

# ============================================
# Instagram
# ============================================
# If your Instagram Business account is linked to the Facebook Page above,
# PAGE_ACCESS_TOKEN usually works for IG messaging too. Only set this
# separately if Meta issues a distinct token for the IG account.
IG_PAGE_ACCESS_TOKEN=

# ============================================
# Google Gemini API (aistudio.google.com)
# ============================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ============================================
# Knowledge base
# ============================================
KNOWLEDGE_BASE_PATH=./knowledge_base/company_info.json

# ============================================
# Central multi-page webhook
# ============================================
# Stores Page IDs and Page Access Tokens added from /pages.
PAGES_CONFIG_PATH=./data/pages.json
KNOWLEDGE_BASES_DIR=./data/knowledge_bases

# Required to open /pages. Browser username can be anything; password must match this.
ADMIN_PASSWORD=

# Optional shared secret for the Nanovate destination webhook relay.
# Put the token in the destination URL as ?token=... or send it as X-Router-Token.
ROUTER_WEBHOOK_TOKEN=
ROUTER_DEFAULT_CLIENT_ID=etihad

# Human-like pause before replies, in milliseconds.
RESPONSE_DELAY_MIN_MS=1200
RESPONSE_DELAY_MAX_MS=3200

# ============================================
# Conversation memory
# ============================================
# How many minutes of inactivity before a user's short chat history resets
HISTORY_TTL_MINUTES=30
# How many past turns to keep per user
HISTORY_MAX_TURNS=20


وساعتها اللينك اللي تديه للعميل يكون:
https://etihad.cvis.com.eg/router-webhook/etihad?token=اي_توكن_سري
